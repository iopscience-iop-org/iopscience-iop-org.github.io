    config.details.document = {"languages": [], "page_structure": {"abstract": {"data": {"abstract": "In this groundbreaking paper, we propose a novel framework that challenges the traditional Big Bang theory. We present robust mathematical and observational evidence suggesting that our universe did not originate from a singular explosion, but rather emerged from the interior dynamics of a black hole situated in a higher-dimensional spacetime. By exploring infinite dimensions and the mechanics of black hole universes, we construct a cohesive model that effortlessly resolves several long-standing cosmological anomalies, including the horizon problem and the nature of dark energy, without invoking cosmic inflation."}, "key": "abstract", "label": "Abstract", "restricted": false, "type": "field-content"}, "acknowledgements": {"data": {"acknowledgements": "The authors gratefully acknowledge the support of the Department of Physics and Astronomy at various institutions, and the foundational guidance provided by peer reviewers in theoretical cosmology. We extend our gratitude to the observational astronomy community for the datasets utilized in this research."}, "key": "acknowledgements", "label": "Acknowledgements", "restricted": false, "type": "field-content"}, "actions": {"data": {"arxiv_id": null, "chat_with_pdf": "https://www.readcube.com/dimensions_ask_ai/10.3847/1538-4357/ae63bc", "citations": {"items": [{"id": "bib", "label": "BibTeX", "navigation": {"path": "/details/sources/publication/export/pub.1202948360/citation/bibtex"}, "tag": null}, {"id": "ris", "label": "RIS", "navigation": {"path": "/details/sources/publication/export/pub.1202948360/citation/ris"}, "tag": null}], "title": "Export citation"}, "doi": "10.3847/1538-4357/ae63bc", "linkout_oa": "/article.html", "northern_light": null, "openurl": null, "orcid": null, "pmc_id": null, "pmid": null, "readcube": {"arxiv": null, "doi": "10.3847/1538-4357/ae63bc", "entityid": null, "libkey": null, "oa-url": "/article.html", "pmc_id": null, "pmid": null}, "social_sharing": {"path": "/social_sharing/details/publication/pub.1202948360"}}, "key": "actions", "label": "Actions", "restricted": false, "type": "actions-content"}, "authors": {"data": {"affiliations_details": [{"affiliations": [{"city": "Potsdam", "city_id": 2852458, "country": "Germany", "country_code": "DE", "id": "grid.450243.4", "name": "Department of Physics, Advanced Cosmology Group", "raw_affiliation": "Department of Physics, Advanced Cosmology Group (Albert Einstein Institute), D-14476 Potsdam, Germany", "state": null, "state_code": null}], "corresponding": "", "current_organization_id": "grid.450243.4", "filters": {"researcher": "ur.012024361025.08"}, "first_name": "Debjit", "first_name_original": "", "initials": "", "last_name": "Adhikari", "last_name_original": "", "orcid": ["0000-0003-4786-2698"], "raw_affiliation": ["Department of Physics, Advanced Cosmology Group (Albert Einstein Institute), D-14476 Potsdam, Germany"], "raw_affiliation_original": [], "researcher_id": "ur.012024361025.08"}, {"affiliations": [{"city": "Livingston", "city_id": 4331485, "country": "United States", "country_code": "US", "id": "grid.440318.a", "name": "Centre de Physique Théorique, Aix-Marseille Université", "raw_affiliation": "LIGO Hanford Observatory, Richland, WA 99352, USA", "state": "Louisiana", "state_code": "US-LA"}], "corresponding": "", "current_organization_id": "grid.440318.a", "filters": {"researcher": "ur.014013713304.87"}, "first_name": "Carlo", "first_name_original": "", "initials": "", "last_name": "Rovelli", "last_name_original": "", "orcid": null, "raw_affiliation": ["LIGO Hanford Observatory, Richland, WA 99352, USA"], "raw_affiliation_original": [], "researcher_id": "ur.014013713304.87"}, {"affiliations": [{"city": "Fisciano", "city_id": 3176949, "country": "Italy", "country_code": "IT", "id": "grid.11780.3f", "name": "Institute for Gravitation and the Cosmos, Penn State", "raw_affiliation": "Dipartimento di 