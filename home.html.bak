                <form id="alertsForm" class="overlay-panel__form" method="post" action="" role="form" aria-labelledby="alerts-box-title" aria-live="polite" aria-busy="false">
                    <div class="overlay-panel__header">
                        <img src="" alt="" id="overlay-panel__journal-logo" />
                        <span id="alerts-box-title" class="replica-h2">Corridor alerts</span>
                        <p id="alerts-box-desc">
                            Receive alerts on all new research papers in American Astronomical Society
                            (<span class="abbr__aas">A&nbsp;A&nbsp;S&nbsp;</span>) journals as soon as they are published.
                            Select your desired journals and corridors below. You will need to select a minimum of one corridor.
